# Form endpoint that receives contact-form messages.
# 1. Create a free form at https://formspree.io/ (it takes ~2 minutes)
# 2. Copy the endpoint URL it gives you (looks like https://formspree.io/f/abcdwxyz)
# 3. Put it here (locally) AND in Vercel → Project → Settings → Environment Variables
#    (same name) so the deployed site sends messages too. Redeploy after adding it.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
